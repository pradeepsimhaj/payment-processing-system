{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "ignoreDeprecations": "5.0",
    "isolatedModules": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}